# ==============================================================================
# Django CRM Project — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control!
#
# On production server: /var/www/mi_crm/.env
# On local dev: /path/to/mi_crm/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core
# ------------------------------------------------------------------------------
# Generate a strong secret key (50+ random characters):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed hostnames/IPs (no spaces)
# Example: crm.microimageph.com,10.30.30.100,localhost
ALLOWED_HOSTS=crm.microimageph.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database — MariaDB (Production) / SQLite (Dev Fallback)
# ------------------------------------------------------------------------------
# For production: DB_ENGINE=mariadb
# For local dev: DB_ENGINE=sqlite3 (or leave unset)
DB_ENGINE=mariadb

DB_NAME=mi_crm
DB_USER=mi_crm_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# SQLite path (only used if DB_ENGINE=sqlite3)
SQLITE_PATH=/var/www/mi_crm/db.sqlite3

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
EMAIL_HOST=email.microimageph.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=crm_sales@microimageph.com
EMAIL_HOST_PASSWORD=CHANGE_THIS_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=sales@microimageph.com

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# In production, set CORS_ALLOW_ALL_ORIGINS=False and whitelist specific origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://crm.microimageph.com,https://www.microimageph.com

# ------------------------------------------------------------------------------
# Redmine Integration
# ------------------------------------------------------------------------------
REDMINE_URL=http://10.30.30.131
REDMINE_USERNAME=customer_service
REDMINE_API_KEY=CHANGE_THIS_REDMINE_API_KEY
REDMINE_PROJECT_ID=14
REDMINE_TRACKER_ID=7

# ------------------------------------------------------------------------------
# Site URL (for email links and absolute URLs in background jobs)
# ------------------------------------------------------------------------------
# Set this to match how users access your CRM
# Development examples: http://127.0.0.1:8000 or http://10.10.10.125:8001
# Production example: https://crm.microimageph.com
SITE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Production Security (optional overrides)
# ------------------------------------------------------------------------------
# Force HTTPS redirect (set False if using a reverse proxy that handles SSL termination)
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# Sales Funnel — "Clear Stage" bulk cleanup passcode (production only)
# ------------------------------------------------------------------------------
# On production (DEBUG=False), the admin "Clear Stage" tool requires this
# passcode before it will delete TEST funnel entries for a month/stage.
# Leave blank to DISABLE Clear Stage on production entirely.
# Ignored on dev/test machines (DEBUG=True), where Clear Stage runs freely.
FUNNEL_CLEAR_STAGE_CODE=
